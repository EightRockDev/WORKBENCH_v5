# ===========================================================================
# Eight Rock Workbench v5.0 — Streamlit secrets (Section 9.1 / 9.4)
# ---------------------------------------------------------------------------
# Copy to .streamlit/secrets.toml and fill in. NEVER commit the real file, and
# NEVER place it in a OneDrive-synced folder (Section 9.2). .gitignore already
# excludes secrets.toml.
#
# Auth uses Streamlit's native OpenID Connect (st.login / st.user / st.logout,
# native since Streamlit 1.42) with a hosted identity provider behind it
# (Section 9.4). Pick ONE provider block below.
# ===========================================================================

# --- Database (Section 9.1 / 9.2: live DB on server local disk only) -------
[postgres]
url = "postgresql://workbench:CHANGE_ME@127.0.0.1:5432/workbench"

# ---------------------------------------------------------------------------
# [auth] — Streamlit native OIDC. cookie_secret must be a strong random string
# (generate: python -c "import secrets;print(secrets.token_urlsafe(48))").
# ---------------------------------------------------------------------------
[auth]
redirect_uri   = "https://workbench.eight-rock.com/oauth2callback"
cookie_secret  = "GENERATE_A_STRONG_RANDOM_STRING"

# --- Option A: Auth0 (recommended for the pilot — Google + Microsoft +
#     email/password + hosted admin console; free up to 25,000 MAU) ----------
[auth.auth0]
client_id     = "YOUR_AUTH0_CLIENT_ID"
client_secret = "YOUR_AUTH0_CLIENT_SECRET"
server_metadata_url = "https://YOUR_TENANT.us.auth0.com/.well-known/openid-configuration"

# --- Option B: Microsoft Entra External ID (Microsoft-native; reuses the
#     MSAL scaffold in core/auth.py). Uncomment to use instead of Auth0. -----
# [auth.microsoft]
# client_id     = "YOUR_ENTRA_APP_CLIENT_ID"
# client_secret = "YOUR_ENTRA_APP_CLIENT_SECRET"
# server_metadata_url = "https://login.microsoftonline.com/YOUR_TENANT_ID/v2.0/.well-known/openid-configuration"
