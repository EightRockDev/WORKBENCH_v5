# ===========================================================================
# Eight Rock Workbench v5.0 — Streamlit secrets (Section 9.1 / 9.4)
# ---------------------------------------------------------------------------
# Copy to .streamlit/secrets.toml and fill in. NEVER commit the real file, and
# NEVER place it in a OneDrive-synced folder (Section 9.2). .gitignore already
# excludes secrets.toml.
#
# Auth uses Streamlit's native OpenID Connect (st.login / st.user / st.logout,
# native since Streamlit 1.42) with a hosted identity provider behind it
# (Section 9.4). core/oidc.py calls st.login() with NO provider argument, so it
# reads the SINGLE DEFAULT provider — every auth key must live DIRECTLY under
# [auth], NOT under a named [auth.<name>] sub-table. A nested block makes
# st.login() report "missing keys: client_id, client_secret, server_metadata_url"
# even though they're right there. (One provider — Auth0 — federates Google +
# Microsoft + email/password internally, so we never need multiple providers.)
# ===========================================================================

# --- Database (Section 9.1 / 9.2: live DB on server local disk only) --------
# LEAVE THIS COMMENTED when you provisioned the DB with deploy/windows/
# setup-db.ps1 — that script writes the real DATABASE_URL (with the generated
# password) into .env, and the app reads it from there. secrets.toml's
# [postgres].url takes PRECEDENCE over .env, so an un-filled placeholder here
# will OVERRIDE the working .env URL and break the connection. Only uncomment
# and fill this if you are NOT using .env for the DB.
# [postgres]
# url = "postgresql://workbench:REAL_PASSWORD@127.0.0.1:5432/workbench"

# ---------------------------------------------------------------------------
# [auth] — Streamlit native OIDC, SINGLE default provider. All five keys go
# directly under [auth]. cookie_secret must be a strong random string:
#   PowerShell: $b=New-Object 'byte[]' 48; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b).TrimEnd('=').Replace('+','-').Replace('/','_')
#   Python:     python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Values shown are for Auth0 (recommended for the pilot — Google + Microsoft +
# email/password + hosted admin console, free up to 25,000 MAU). To point
# Streamlit directly at Microsoft Entra External ID instead, keep this same
# flat [auth] block and swap client_id / client_secret / server_metadata_url
# for the Entra app's values (metadata URL:
# https://login.microsoftonline.com/YOUR_TENANT_ID/v2.0/.well-known/openid-configuration).
# ---------------------------------------------------------------------------
[auth]
redirect_uri        = "https://workbench.eight-rock.com/oauth2callback"
cookie_secret       = "GENERATE_A_STRONG_RANDOM_STRING"
client_id           = "YOUR_AUTH0_CLIENT_ID"
client_secret       = "YOUR_AUTH0_CLIENT_SECRET"
server_metadata_url = "https://YOUR_TENANT.us.auth0.com/.well-known/openid-configuration"
