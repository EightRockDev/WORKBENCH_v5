# Eight Rock Workbench — environment configuration
#
# Copy this file to `.env` (in the same `python_workbench/` directory),
# fill in the values, and the workbench will pick them up automatically
# via python-dotenv on app startup.
#
# `.env` is gitignored. Never commit your real keys.

# ---------------------------------------------------------------------------
# Anthropic API — required for the Artifact Engine on the Exec Summary tab.
# Powers LLM-generated deal docs (Exec Summary, Investor Memos, Value-Add, LOI).
# Without this key, the artifact buttons show a setup warning; the rest of
# the workbench (data, ETL, comps, underwriting math, exports) works fine.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...your-key-here...


# ---------------------------------------------------------------------------
# Workbench identity — surfaced in the top-bar version pill
# ---------------------------------------------------------------------------
APP_VERSION=v0.96.05262026

# ---------------------------------------------------------------------------
# Module A — Skip Trace vendor keys (spec §4). Set ER_SKIPTRACE_PROVIDERS=live
# to use real vendors; each provider falls back to a mock if its key is unset,
# so you can go live one vendor at a time. These calls cost real money per
# request (the FR-A5 budget cap still guards spend).
# ---------------------------------------------------------------------------
# ER_SKIPTRACE_PROVIDERS=live
# BATCHDATA_API_KEY=...        # batchdata.io — phones/emails/DNC (start here)
# TRESTLE_API_KEY=...          # trestleiq.com — phone validation + litigator
# VA_SCC_API_TOKEN=...         # Virginia SCC — entity -> officers (free)
