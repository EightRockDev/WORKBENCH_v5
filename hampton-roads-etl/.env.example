# Hampton Roads ETL — API keys
# Copy this file to .env (gitignored) and fill in your keys.
# All keys are FREE — sign-up links in README.md.

# Phase 1
CENSUS_API_KEY=
BLS_API_KEY=
FRED_API_KEY=
HUD_API_TOKEN=

# Phase 2 — none of the four new sources currently require keys.
# (BAH, Census BPS, HUD LIHTC, FFIEC HMDA all serve public data without auth.)

# OPTIONAL: HMDA's slowest step is resolving each unique LEI to a lender name
# via the GLEIF API (~3s per LEI). Set to 0 to skip — you get LEI codes but
# no human-readable bank names.
HMDA_RESOLVE_LENDER_NAMES=1
